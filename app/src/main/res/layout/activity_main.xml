<?xml version="1.0" encoding="utf-8"?>
<!--
    Main screen of CampusLife (portrait).

    Layout strategy:
      * a vertical LinearLayout splits the screen between the banner and the
        button grid with layout_weight, so nothing depends on a fixed size;
      * the banner is a RelativeLayout that puts the 40sp title on top of the
        campus photo (the only fixed text size allowed by the specification);
      * the four service areas sit in a GridLayout using columnWeight/rowWeight,
        which makes the two-by-two grid scale with any screen size;
      * each ImageButton uses the button_selector drawable so that it is green at
        rest and light green while pressed.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Banner: campus photo with the application title on top -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2">

        <ImageView
            android:id="@+id/ivBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/banner_description"
            android:scaleType="centerCrop"
            android:src="@drawable/img_main_banner" />

        <TextView
            android:id="@+id/tvBannerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:padding="@dimen/banner_title_padding"
            android:text="@string/banner_title"
            android:textColor="@android:color/white"
            android:textSize="40sp" />
    </RelativeLayout>

    <!-- The four service areas in a two-by-two grid on a green background -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:background="@color/green"
        android:columnCount="2"
        android:rowCount="2">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/button_margin"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnFacilities"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/label_facilities"
                android:onClick="onFacilitiesClick"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_facilities" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_facilities"
                android:textColor="@android:color/white"
                android:textSize="@dimen/button_label_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/button_margin"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnEvents"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/label_events"
                android:onClick="onEventsClick"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_events" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_events"
                android:textColor="@android:color/white"
                android:textSize="@dimen/button_label_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/button_margin"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnClubs"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/label_clubs"
                android:onClick="onClubsClick"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_clubs" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_clubs"
                android:textColor="@android:color/white"
                android:textSize="@dimen/button_label_size" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_columnWeight="1"
            android:layout_margin="@dimen/button_margin"
            android:layout_rowWeight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnSupport"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:background="@drawable/button_selector"
                android:contentDescription="@string/label_support"
                android:onClick="onSupportClick"
                android:scaleType="fitCenter"
                android:src="@drawable/img_btn_support" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_support"
                android:textColor="@android:color/white"
                android:textSize="@dimen/button_label_size" />
        </LinearLayout>
    </GridLayout>

</LinearLayout>
